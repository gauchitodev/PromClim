[Unit]
Description=PromClim: guarda el pronóstico del día y lo que midieron las estaciones
# Le pide a PromClim por el puerto; si no está corriendo, promclim.socket lo prende.
Requires=promclim.socket
After=promclim.socket network-online.target

[Service]
Type=oneshot
ExecStart=__NODE__ __CARPETA__/sistema/registrar.mjs __PUERTO__
